# Copy this file to `.env` and adjust the values.

PORT=4000
NODE_ENV=development

# Where the SQLite file lives (created automatically)
DATABASE_PATH=./data/stockmaster.db

# REQUIRED in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Allowed frontend origin(s), comma separated. Vite's default is 5173.
CORS_ORIGIN=http://localhost:5173

# Virtual money every new user starts with (in ₹)
STARTING_BALANCE=100000

# Simulated market: how often prices move (seconds). 0 = never (manual only)
MARKET_TICK_SECONDS=60
# Largest single-tick move, in percent (a tick moves each stock by -X% .. +X%)
MARKET_VOLATILITY_PCT=2
# Notify users who watch a stock when it moves at least this many percent
PRICE_ALERT_THRESHOLD_PCT=1.8
# Seconds a cached market calculation stays valid
MARKET_CACHE_TTL_SECONDS=30
# Lets any logged-in user call POST /api/market/tick (handy for demos)
ALLOW_MANUAL_TICK=true
